{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:component",
    "component": "minecraft:item_model",
    "cases": [
      {
        "when": "illyriacore:incendium_key",
        "model": {
          "type": "minecraft:model",
          "model": "illyriacore:item/incendium_key"
        }
      },
      {
        "when": "illyriacore:nullscape_key",
        "model": {
          "type": "minecraft:model",
          "model": "illyriacore:item/nullscape_key"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/trial_key"
    }
  }
}
