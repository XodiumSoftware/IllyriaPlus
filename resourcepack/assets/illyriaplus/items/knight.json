{
    "model": {
        "type": "minecraft:select",
        "property": "minecraft:custom_model_data",
        "index": 0,
        "cases": [
            {
                "when": "head",
                "model": {
                    "type": "minecraft:model",
                    "model": "illyriaplus:item/armor/knight_helmet"
                }
            },
            {
                "when": "chest",
                "model": {
                    "type": "minecraft:model",
                    "model": "illyriaplus:item/armor/knight_chestplate"
                }
            },
            {
                "when": "legs",
                "model": {
                    "type": "minecraft:model",
                    "model": "illyriaplus:item/armor/knight_leggings"
                }
            },
            {
                "when": "feet",
                "model": {
                    "type": "minecraft:model",
                    "model": "illyriaplus:item/armor/knight_boots"
                }
            }
        ],
        "fallback": {
            "type": "minecraft:model",
            "model": "illyriaplus:item/armor/knight_chestplate"
        }
    }
}