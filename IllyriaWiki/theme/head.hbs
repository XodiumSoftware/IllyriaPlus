<script>
    // Inject a Discord link next to the Git repository link in the navbar.
    // Mirrors the GitHub <a> so it picks up existing icon-button styles.
    //
    // NOTE: [preprocessor.variables.variables] only applies to markdown, not to
    // theme templates, so the invite URL must be hardcoded here. Keep in sync
    // with `discord_invite` in `book.toml`.
    document.addEventListener("DOMContentLoaded", () => {
        const gitLink = document.querySelector('a[title="Git repository"]');
        if (!gitLink || document.querySelector('a[title="Discord"]')) return;

        const discordLink = document.createElement("a");
        discordLink.href = "https://discord.gg/jusYH9aYUh";
        discordLink.title = "Discord";
        discordLink.setAttribute("aria-label", "Discord");
        discordLink.target = "_blank";
        discordLink.rel = "noopener noreferrer";
        discordLink.innerHTML = `
            <span class="fa-svg"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0282c1.9459 1.5996 3.8301 2.5677 5.6821 3.2047a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7931 8.18 1.7931 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.861-.637 3.7476-1.6056 5.6935-3.2052a.077.077 0 00.0312-.0282c.5-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189z"/>
            </svg></span>
        `;
        gitLink.parentNode.insertBefore(discordLink, gitLink.nextSibling);
    });
</script>
